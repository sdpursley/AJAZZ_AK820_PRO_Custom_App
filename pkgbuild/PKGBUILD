pkgname=ak820
pkgver=0.1.0
pkgrel=1
pkgdesc='Lighting and screen for the AJAZZ AK820 Pro'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('hidapi' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
install=ak820.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ak820 "$pkgdir/usr/bin/ak820"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ak820.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ak820.svg"
  install -Dm644 "$startdir/ak820.desktop" "$pkgdir/usr/share/applications/ak820.desktop"
  install -Dm644 "$startdir/70-ak820.rules" "$pkgdir/usr/lib/udev/rules.d/70-ak820.rules"
}
